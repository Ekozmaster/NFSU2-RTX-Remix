over "Looks"
{
    def Material "FlagLamp_01" (
        references = @../../../../materials/AperturePBR_Opacity.usda@</Looks/mat_AperturePBR_Opacity>
    )
    {
        over "Shader"
        {
            bool inputs:blend_enabled = 0
            asset inputs:diffuse_texture = @./FlagLamps_albedo.dds@
            float inputs:metallic_constant = 0
            asset inputs:metallic_texture = @./FlagLamps_metal.dds@
            asset inputs:normalmap_texture = @./FlagLamps_normal.dds@
            float inputs:reflection_roughness_constant = 0.5
            asset inputs:reflectionroughness_texture = @./FlagLamps_rough.dds@
            bool inputs:use_legacy_alpha_state = 1
        }
    }
}

