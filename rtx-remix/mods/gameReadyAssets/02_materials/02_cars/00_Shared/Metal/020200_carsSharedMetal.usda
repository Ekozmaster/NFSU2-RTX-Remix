over "Looks"
{
    def Material "Diamond_Plate_Light" (
        references = @../../../../materials/AperturePBR_Opacity.usda@</Looks/mat_AperturePBR_Opacity>
    )
    {
        over "Shader"
        {
            color3f inputs:diffuse_color_constant = (0.8, 0.8, 0.8)
            asset inputs:diffuse_texture = @./Diamond_Plate_light_albedo.dds@
            float inputs:metallic_constant = 0.79999995
            asset inputs:metallic_texture = @./Diamond_Plate_metal.dds@
            asset inputs:normalmap_texture = @./Diamond_Plate_normal.dds@
            float inputs:reflection_roughness_constant = 0.5
            asset inputs:reflectionroughness_texture = @./Diamond_Plate_rough.dds@
        }
    }

    def Material "Diamond_Plate_Dark" (
        references = @../../../../materials/AperturePBR_Opacity.usda@</Looks/mat_AperturePBR_Opacity>
    )
    {
        over "Shader"
        {
            color3f inputs:diffuse_color_constant = (0.8, 0.8, 0.8)
            asset inputs:diffuse_texture = @./Diamond_Plate_dark_albedo.dds@
            float inputs:metallic_constant = 0.79999995
            asset inputs:metallic_texture = @./Diamond_Plate_metal.dds@
            asset inputs:normalmap_texture = @./Diamond_Plate_normal.dds@
            float inputs:reflection_roughness_constant = 0.5
            asset inputs:reflectionroughness_texture = @./Diamond_Plate_rough.dds@
        }
    }
}

